<link rel="stylesheet" href="/css/style.css">

<h2>Agregar Novedad</h2>

{{#if error}}
    <p class="error">{{message}}</p>
{{/if}}

<form action="/admin/novedades/agregar" method="POST">
    <label>Titulo:</label>
    <input type="text" name="titulo" value="{{novedad.titulo}}" required>

    <label>Subtitulo:</label>
    <textarea name="subtitulo" required>{{novedad.subtitulo}}</textarea>

    <label>Cuerpo:</label>
    <textarea name="cuerpo" required>{{novedad.cuerpo}}</textarea>

    <button type="submit">Agregar</button>
</form>
