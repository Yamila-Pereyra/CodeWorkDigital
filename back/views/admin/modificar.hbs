<h2>Modificar Novedad</h2>

{{#if error}}
    <p style="color:red">{{message}}</p>
{{/if}}

<form action="/admin/novedades/modificar" method="POST">
    <input type="hidden" name="id" value="{{novedad.id}}">

    <label>Titulo:</label>
    <input type="text" name="titulo" value="{{novedad.titulo}}" required>

    <label>Subtitulo:</label>
    <textarea name="subtitulo" required>{{novedad.subtitulo}}</textarea>

    <label>Cuerpo:</label>
    <textarea name="cuerpo" required>{{novedad.cuerpo}}</textarea>

    <button type="submit">Modificar</button>
</form>
